{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yuristim-api-v3-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "staging",
    "APP_VERSION": "0.5.0",
    "API_VERSION": "v1",
    "PUBLIC_BASE_URL": "https://yuristim-api-v3-staging.diyorbeknematov28042007.workers.dev",
    "CORS_ALLOWLIST": "",
    "REQUEST_TIMEOUT_MS": "5000",
    "MAX_REQUEST_BYTES": "1048576",
    "SESSION_TTL_SECONDS": "2592000",
    "TELEGRAM_AUTH_MAX_AGE_SECONDS": "300",
    "GIT_COMMIT_SHA": "unavailable",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yuristim-db-v3-staging",
      "database_id": "01d72d07-1fd7-41f7-9550-3cb58333b3e3",
      "migrations_dir": "../../migrations",
      "migrations_table": "d1_migrations",
    },
  ],
  "triggers": {
    "crons": ["0 19 * * SUN", "5 * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
