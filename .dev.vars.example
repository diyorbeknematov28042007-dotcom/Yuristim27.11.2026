APP_ENV=development
APP_VERSION=0.4.0
API_VERSION=v1
PUBLIC_BASE_URL=http://localhost:8787
CORS_ALLOWLIST=http://localhost:3000,http://127.0.0.1:3000
REQUEST_TIMEOUT_MS=5000
MAX_REQUEST_BYTES=1048576
SESSION_TTL_SECONDS=2592000
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TELEGRAM_BOT_TOKEN=replace-with-rotated-token
TELEGRAM_OIDC_CLIENT_ID=replace-with-botfather-client-id
TELEGRAM_OIDC_CLIENT_SECRET=replace-with-botfather-client-secret
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
BOT_ADAPTER_SECRET=replace-with-random-adapter-secret
AUTH_ENCRYPTION_KEY=replace-with-base64url-encoded-32-byte-key
OWNER_TELEGRAM_ID=replace-with-owner-telegram-id
