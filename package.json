{
  "name": "yuristim",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Yuristim modular platform and shared design system",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @yuristim/api dev",
    "build": "pnpm --filter @yuristim/api build && pnpm design:build",
    "design:dev": "pnpm --filter @yuristim/design-preview dev",
    "design:build": "pnpm --filter @yuristim/design-preview build",
    "design:preview": "pnpm --filter @yuristim/design-preview preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:api && pnpm test:design && pnpm test:workflow",
    "test:api": "vitest run --config apps/api/vitest.config.ts",
    "test:design": "vitest run --config vitest.design.config.ts",
    "test:workflow": "node --test scripts/deployment-ref-policy.test.mjs",
    "test:integration": "vitest run --config apps/api/vitest.config.ts apps/api/tests/integration apps/api/tests/database",
    "test:security": "vitest run --config apps/api/vitest.config.ts apps/api/tests/security",
    "db:validate": "node scripts/validate-migrations.mjs",
    "db:migrate:local": "pnpm --filter @yuristim/api db:migrate:local",
    "db:migrate:staging": "pnpm --filter @yuristim/api db:migrate:staging",
    "deploy:staging": "pnpm --filter @yuristim/api deploy:staging",
    "types": "pnpm --filter @yuristim/api types",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "audit:dependencies": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.2",
    "@cloudflare/workers-types": "5.20261127.1",
    "@eslint/js": "10.0.1",
    "@msw/cloudflare": "0.2.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "msw": "3.0.8",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  }
}
