{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node", "@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "apps/api/worker-configuration.d.ts",
    "apps/api/test-env.d.ts",
    "apps/api/src/**/*.ts",
    "apps/api/tests/**/*.ts",
    "apps/design-preview/src/**/*.ts",
    "apps/design-preview/src/**/*.tsx",
    "apps/design-preview/vite.config.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/tests/**/*.ts",
    "packages/*/tests/**/*.tsx",
    "vitest.design.config.ts"
  ]
}
